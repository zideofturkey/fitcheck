# Development Environment

SERVICE_NAME=lrmwufitcheck-frontend
SERVICE_SHORT_NAME=frontend
SERVICE_CODENAME=lrmwufitcheck-frontend
SERVICE_URL=http://localhost:8080
SERVICE_URL_SUFFIX=

# Vite dev server listen port (consumed by `pnpm dev` only)
VITE_PORT=*****

# Base URL for all backend services (auth-api, bff-api, etc.)
VITE_SERVICE_URL=

# Backend service URLs — one per service, consumed by the vite
# dev proxy (see vite.config.ts) to route /<svc>-api requests to
# each backend's localhost port. Override individually if you run
# a service on a non-default port locally.
VITE_AUTH_URL=http://localhost:3001
VITE_BFF_URL=http://localhost:3002
VITE_NOTIFICATION_URL=http://localhost:3003
VITE_MCP_BFF_URL=http://localhost:3005
VITE_AGENTHUB_URL=http://localhost:3006
VITE_INVITATIONCENTER_URL=http://localhost:3050
VITE_NUTRITIONLIBRARY_URL=http://localhost:3051
VITE_MEALTRACKER_URL=http://localhost:3052
VITE_NUTRITIONAI_URL=http://localhost:3053
