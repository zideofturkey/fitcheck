# Local Development Configuration for invitationCenter-service
# Auto-generated with consistent dev port: 3050

# Server Configuration
HTTP_PORT=*****
SERVICE_URL=*****

# Environment
CONFIG_ENV=*****
NODE_ENV=*****

# Service Identity
SERVICE_NAME=*****
SERVICE_SHORT_NAME=*****

# Signing Keys (Ed25519, PKCS#8 PEM) — placeholders only.
# These are fetched by the deployer from Genesis at deploy time and
# injected into the service env. Do NOT commit values here — keys
# must not be visible in the repo.
#
# For local development you can populate them manually from:
#   GET /api/genesis/keys/projects/<projectId>/private-key
#   GET /api/genesis/keys/services/<projectId>/<serviceName>/private-key
#
# Generated code will use these to sign service-to-service requests
# (the public counterparts are published via Genesis JWKS).
PROJECT_SECRET_KEY=*****
SERVICE_SECRET_KEY=*****

# Copy other required variables from .dev.env as needed
# Database, Redis, Elasticsearch, etc.