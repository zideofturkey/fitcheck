    "jsonwebtoken": "^9.0.2",
    "openai": "^4.73.0",
    "uuid": "^9.0.0",
    "tldts": "^6.1.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
