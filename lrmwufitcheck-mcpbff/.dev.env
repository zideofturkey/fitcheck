# Server Configuration
HTTP_PORT=3005
HOST=0.0.0.0
NODE_ENV=development
CONFIG_ENV=dev

# Service Identity
SERVICE_NAME=lrmwufitcheck-mcpbff-service
SERVICE_SHORT_NAME=mcpbff
SERVICE_CODENAME=lrmwufitcheck-mcpbff-service
SERVICE_URL=http://localhost:3005
PROJECT_VERSION=1.0.17
SERVICE_VERSION=1.0.17

# Authentication
AUTH_SERVICE_URL=http://localhost:3001
AUTH_VALIDATE_MODE=key

# Service Connections
INVITATIONCENTER_SERVICE_URL=http://localhost:3050
NUTRITIONLIBRARY_SERVICE_URL=http://localhost:3051
MEALTRACKER_SERVICE_URL=http://localhost:3052
NUTRITIONAI_SERVICE_URL=http://localhost:3053
AGENTHUB_SERVICE_URL=http://localhost:3006

# AI Configuration
AI_PROVIDER=auto
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-6
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Elasticsearch
ELASTIC_URI=http://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PWD=
ELASTIC_API_KEY=*****
ES_CHAT_INDEX=lrmwufitcheck_mcpchat

# Redis (for console log streaming)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PWD=
