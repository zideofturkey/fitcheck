{
  "openapi": "3.0.3",
  "info": {
    "title": "setMacroTarget API",
    "description": "Upsert-style API: soft-deletes any existing active macro target for the user before creating a fresh one.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "nutritionlibrary API Server"
    }
  ],
  "tags": [
    {
      "name": "macroTarget",
      "description": "Operations on macroTarget"
    }
  ],
  "paths": {
    "/v1/macro-targets": {
      "post": {
        "operationId": "setMacroTarget",
        "summary": "Upsert-style API: soft-deletes any existing active macro target for the user before creating a fresh one.",
        "description": "Triggered by the Save button on the Macro Targets page. All six target fields are required. On 201, show a toast 'Macro targets updated' and reflect new values in the UI. userId is auto-populated from session — never ask the user for it. effectiveFrom is system-set.",
        "tags": [
          "macroTarget"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "OK"
                    },
                    "macroTarget": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Forbidden"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "calorieTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "proteinTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "carbohydrateTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "fatTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "sugarTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "fiberTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  }
                },
                "required": [
                  "calorieTarget",
                  "proteinTarget",
                  "carbohydrateTarget",
                  "fatTarget",
                  "sugarTarget",
                  "fiberTarget"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from authentication service"
      }
    }
  }
}