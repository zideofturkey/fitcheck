{
  "openapi": "3.0.3",
  "info": {
    "title": "createFoodItem API",
    "description": "Create a food item in the user's personal food library.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "nutritionlibrary API Server"
    }
  ],
  "tags": [
    {
      "name": "foodItem",
      "description": "Operations on foodItem"
    }
  ],
  "paths": {
    "/v1/food-items": {
      "post": {
        "operationId": "createFoodItem",
        "summary": "Create a food item in the user's personal food library.",
        "description": "Triggered from 'Add Food' form on the Food Library page, or programmatically by the AI assistant. All per-100g fields are required. brandName and foodCategory are optional. creationSource defaults to manualEntry. On 201, append to the food list and show a toast 'Food saved'. userId is auto-populated from session.",
        "tags": [
          "foodItem"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "OK"
                    },
                    "foodItem": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Forbidden"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Error"
                    },
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "foodName": {
                    "type": "string",
                    "description": ""
                  },
                  "caloriePer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "proteinPer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "carbohydratePer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "fatPer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "sugarPer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "fiberPer100g": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "brandName": {
                    "type": "string",
                    "description": ""
                  },
                  "foodCategory": {
                    "type": "string",
                    "description": ""
                  },
                  "creationSource": {
                    "type": "string",
                    "description": ""
                  }
                },
                "required": [
                  "foodName",
                  "caloriePer100g",
                  "proteinPer100g",
                  "carbohydratePer100g",
                  "fatPer100g",
                  "sugarPer100g",
                  "fiberPer100g"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from authentication service"
      }
    }
  }
}