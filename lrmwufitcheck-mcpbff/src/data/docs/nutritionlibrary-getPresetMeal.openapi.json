{
  "openapi": "3.0.3",
  "info": {
    "title": "getPresetMeal API",
    "description": "Fetch a preset meal with its lines joined.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "nutritionlibrary API Server"
    }
