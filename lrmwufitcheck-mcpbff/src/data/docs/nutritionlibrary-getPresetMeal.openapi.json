              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "OK"
                    },
                    "presetMeal": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
