            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "calorieTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "proteinTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "carbohydrateTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
                  "fatTarget": {
                    "type": "number",
                    "format": "double",
                    "description": ""
                  },
