          "mealLogs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "description": "Optional range start for multi-day queries",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "description": "Optional range end for multi-day queries",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "mealDate",
            "in": "query",
            "required": false,
            "description": "Filter by mealDate",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "logSource",
            "in": "query",
            "required": false,
            "description": "Filter by logSource",
            "schema": {
              "type": "string",
              "description": "Enumerated string value"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageRowCount",
            "in": "query",
            "required": false,
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 25
            }
          },
          {
            "name": "keyword",
            "in": "query",
