{
  "openapi": "3.0.3",
  "info": {
    "title": "deleteFoodItem API",
    "description": "Soft-delete a food item. Ownership enforced.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "nutritionlibrary API Server"
    }
  ],
  "tags": [
    {
      "name": "foodItem",
      "description": "Operations on foodItem"
    }
  ],
  "paths": {
    "/v1/food-items/{foodItemId}": {
      "delete": {
        "operationId": "deleteFoodItem",
        "summary": "Soft-delete a food item. Ownership enforced.",
        "description": "Triggered from the delete button on a food item row. Show a confirmation dialog before calling. On 200, remove the item from the list with a toast 'Food deleted'.",
