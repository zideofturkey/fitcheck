<% let expireTimeStr = null; 
if (expireTime < 60)
  expireTimeStr = `${expireTime} second(s)`
else if (expireTime < 3600)
  expireTimeStr = `${Math.floor(expireTime/60)} minute(s)`
else if (expireTime < 86400)
  expireTimeStr = `${Math.floor(expireTime/3600)} hour(s)`
else 
  expireTimeStr = `${Math.floor(expireTime/86400)} day(s)`
%>
<% if (verificationType == "byLink") { %>
Click the link below to reset your password.(Index <%= codeIndex %>). This link will expire in <%-expireTimeStr %>.
https://web.mindbricks.com/test-area/reset-password?code=<%= secretCode %>&userId=<%= userId %>
If you did not request a password reset, please ignore this message
<% } else { %>
Copy the verification code (Index <%= codeIndex %>) and use it to reset your password. This code will expire in <%-expireTimeStr %>.
<%= secretCode %>
If you did not request a password reset, please ignore this message.
<% } %>