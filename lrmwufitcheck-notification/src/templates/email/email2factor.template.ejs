<% let expireTimeStr = null; 
if (expireTime < 60)
  expireTimeStr = `${expireTime} second(s)`
else if (expireTime < 3600)
  expireTimeStr = `${Math.floor(expireTime/60)} minute(s)`
else if (expireTime < 86400)
  expireTimeStr = `${Math.floor(expireTime/3600)} hour(s)`
else 
  expireTimeStr = `${Math.floor(expireTime/86400)} day(s)`
%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Two Factor Authentication Request</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;">
  <table width="100%" style="max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; padding: 30px;">
    <tr>
      <td align="center">
        <h2 style="color: #333;">Two Factor Authentication Request</h2>
        <% if (verificationType == "byLink") { %>
        <p style="color: #555;">Please complete your login by clicking the button below.(Index <%= codeIndex %>).  This link will expire in <%-expireTimeStr %>.</p>
        <a href="https://web.mindbricks.com/test-area/email-2factor?code=<%= secretCode %>&userId=<%= userId %>" style="display: inline-block; margin-top: 20px; padding: 12px 25px; background-color: #4CAF50; color: white; text-decoration: none; border-radius: 5px;">Verify Email</a>
        <p style="margin-top: 30px; font-size: 12px; color: #888;">If you did not try to login, you can ignore this email.</p>
        <p style="margin-top: 30px; font-size: 12px; color: #888;">https://web.mindbricks.com/test-area/email-2factor?code=<%= secretCode %>&userId=<%= userId %></p>
        <% } else { %>
        <p style="color: #555;">Please complete your login by using the code (Index <%= codeIndex %>) below.  This code will expire in <%-expireTimeStr %>.</p>
        <p style="color: #555;"><%= secretCode %></p>
        <p style="margin-top: 30px; font-size: 12px; color: #888;">If you did not try to login, you can ignore this email.</p>
        <% } %>
      </td>
    </tr>
  </table>
</body>
</html>