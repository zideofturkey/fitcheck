{
  "name": "lrmwufitcheck-panel-service",
  "version": "1.0.17",
  "description": "Frontend for FitCheck",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "start": "vite preview --port 3000 --host",
    "start-test": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode test && vite preview --port 3000 --host",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode test",
    "build-dev": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode dev",
    "build-test": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode test",
    "build-stage": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode stage",
    "build-prod": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode prod",
    "preview": "vite preview --port 3000 --host",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.2",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "lucide-react": "^0.303.0",
    "react-hot-toast": "^2.4.1",
    "react-hook-form": "^7.49.2",
    "@hookform/resolvers": "^3.3.2",
    "zod": "^3.22.4",
    "date-fns": "^3.0.6",
    "react-easy-crop": "^5.0.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "react-qr-code": "^2.0.15",
    "@stripe/stripe-js": "^2.2.2",
    "@stripe/react-stripe-js": "^2.4.0",
    "react-phone-number-input": "^3.4.9"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10"
  }
}
